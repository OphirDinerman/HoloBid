# --- required in production ---
JWT_SECRET=change-me-to-a-long-random-string
ADMIN_EMAILS=            # your Google account email (comma-separated for several admins)
DB_FILE=/data/holobid.db # put this on a persistent disk / volume
# --- Google sign-in (Google Cloud Console > Credentials > OAuth client ID, type Web) ---
GOOGLE_CLIENT_ID=
# --- SMS (Twilio) ---
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=             # your Twilio number, e.g. +1555...
DEFAULT_CC=+972          # country code added to numbers typed without one
VAPID_SUBJECT=mailto:you@example.com  # contact address for push services
# --- local development only (NEVER in production) ---
# DEV_AUTH=1             # fake Facebook login + SMS codes shown on screen
CONTACT_EMAIL=you@example.com   # shown on the privacy / terms / data-deletion pages
SITE_NAME=Holo Bid
PORT=3000

# --- required in production ---
JWT_SECRET=change-me-to-a-long-random-string
ADMIN_FB_IDS=            # your Facebook user ID (comma-separated for several admins)
DB_FILE=/data/holobid.db # put this on a persistent disk / volume
# --- Facebook Login ---
FB_APP_ID=
FB_APP_SECRET=
# --- SMS (Twilio) ---
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=             # your Twilio number, e.g. +1555...
DEFAULT_CC=+972          # country code added to numbers typed without one
# --- local development only (NEVER in production) ---
# DEV_AUTH=1             # fake Facebook login + SMS codes shown on screen
PORT=3000
